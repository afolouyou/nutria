<div class="app-shell">
  <main class="main">
    <.flash_group flash={@flash} />
    {@inner_content}
  </main>

  <nav class="bottom-nav" aria-label="Navegação principal">
    <.link navigate={~p"/chat"} class={[
      "nav-btn",
      @active_tab == "chat" && "active"
    ]}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      <span>Chat</span>
    </.link>

    <.link navigate={~p"/pantry"} class={[
      "nav-btn",
      @active_tab == "pantry" && "active"
    ]}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/></svg>
      <span>Despensa</span>
    </.link>

    <.link navigate={~p"/history"} class={[
      "nav-btn",
      @active_tab == "history" && "active"
    ]}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      <span>Histórico</span>
    </.link>

    <.link navigate={~p"/profile"} class={[
      "nav-btn",
      @active_tab == "profile" && "active"
    ]}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      <span>Perfil</span>
    </.link>
  </nav>
</div>
